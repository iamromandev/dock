#!/usr/bin/env python3
"""Fake `wasmtime` for tests: records its argv and "runs" the guest on the host with python3.

  FAKE_WASMTIME_LOG   file the calls are appended to, one JSON argv list per line

Understands only `run [--dir HOST::GUEST]... [--env NAME[=VALUE]]... -- PROGRAM [ARG]...` and refuses any
other option (so a stray `-S tcp` makes a test fail). The guest is a Python file: PROGRAM itself (the
fixture "modules" are Python files named *.wasm), or, when PROGRAM is a `python.wasm`, the first ARG.
Guest paths given by --dir (such as /plugin) are rewritten to their host folders. The guest's whole
environment is the --env pairs (`--env NAME` takes the value from this process's own environment, as
wasmtime does) plus PATH for the host python; PYTHONHOME is dropped because it names the WASI interpreter's
layout, not the host's.
"""
import json
import os
import sys

argv = sys.argv[1:]
log = os.environ.get("FAKE_WASMTIME_LOG")
if log:
    with open(log, "a") as f:
        f.write(json.dumps(argv) + "\n")


def fail(msg, code=125):
    print(f"fake wasmtime: {msg}", file=sys.stderr)
    sys.exit(code)


if argv[:1] != ["run"]:
    fail(f"unsupported command {argv}")
dirs, env = {}, {}
i = 1
while i < len(argv) and argv[i] != "--":
    flag = argv[i]
    if flag == "--dir" and i + 1 < len(argv) and "::" in argv[i + 1]:
        host, guest = argv[i + 1].split("::", 1)
        dirs[guest] = host
    elif flag == "--env" and i + 1 < len(argv):
        k, eq, v = argv[i + 1].partition("=")
        if eq:
            env[k] = v
        elif k in os.environ:  # `--env NAME`: the client's own value, and nothing if unset
            env[k] = os.environ[k]
    else:
        fail(f"unsupported option {argv[i:i + 2]}")
    i += 2
if i >= len(argv) or i + 1 >= len(argv):
    fail("no program after --")
program, args = argv[i + 1], argv[i + 2:]


def host_path(word):
    for guest, host in dirs.items():
        if word == guest or word.startswith(guest.rstrip("/") + "/"):
            return host + word[len(guest):]
    return word


if os.path.basename(program) == "python.wasm":
    if not args:
        fail("python.wasm without a script")
    script, rest = args[0], args[1:]
else:
    script, rest = program, args
env.pop("PYTHONHOME", None)
env["PATH"] = os.environ.get("PATH", "/usr/bin:/bin")
guest_argv = [host_path(script), *[host_path(a) for a in rest]]
os.execve(sys.executable, [sys.executable, *guest_argv], env)
