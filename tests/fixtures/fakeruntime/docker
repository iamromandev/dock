#!/usr/bin/env python3
"""Fake Docker-compatible runtime for tests: records every call, keeps images and
running containers in a JSON state file, and "runs" a container by exec'ing its
command on the host with only the -e variables as environment.

  FAKE_RUNTIME_LOG          file the calls are appended to, one JSON argv list per line
  FAKE_RUNTIME_STATE        JSON state (default: $FAKE_RUNTIME_LOG.state)
  FAKE_RUNTIME_BUILD_EXIT   exit code of `build` (default 0; non-zero builds no image)
  FAKE_RUNTIME_PS_SLEEP     seconds `ps` hangs before answering (default 0)
  FAKE_RUNTIME_IMAGE_SLEEP  seconds `image rm` hangs before answering (default 0)

Containers are never removed on their own (no --rm emulation): only `rm -f` does,
so tests can check that every started container was removed.
"""
import fcntl
import json
import os
import shutil
import sys
import time

IMAGE_PATH = "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

argv = sys.argv[1:]
log = os.environ.get("FAKE_RUNTIME_LOG")
state_path = os.environ.get("FAKE_RUNTIME_STATE") or (log + ".state" if log else None)
if log:
    with open(log, "a") as f:
        f.write(json.dumps(argv) + "\n")


class State:
    def __enter__(self):
        self.lock = open((state_path or os.devnull) + ".lock", "w") if state_path else None
        if self.lock:
            fcntl.flock(self.lock, fcntl.LOCK_EX)
        self.data = {"images": {}, "running": {}}
        if state_path and os.path.exists(state_path):
            with open(state_path) as f:
                self.data = json.load(f)
        return self.data

    def __exit__(self, *exc):
        if state_path:
            with open(state_path, "w") as f:
                json.dump(self.data, f)
        if self.lock:
            self.lock.close()


def fail(msg, code=1):
    print(msg, file=sys.stderr)
    sys.exit(code)


def image_inspect(args):
    with State() as st:
        if args[0] not in st["images"]:
            fail(f"Error: No such image: {args[0]}")
    print("[]")


def image_rm(args):
    time.sleep(float(os.environ.get("FAKE_RUNTIME_IMAGE_SLEEP", "0")))
    tag = args[-1]
    with State() as st:
        if tag not in st["images"]:
            fail(f"Error response from daemon: No such image: {tag}")
        del st["images"][tag]


def build(args):
    tag = context = None
    i = 0
    while i < len(args):
        if args[i] in ("-t", "-f"):
            if args[i] == "-t":
                tag = args[i + 1]
            i += 2
        else:
            context = args[i]
            i += 1
    print(f"fake build of {tag} from {context}")
    print("fake build log line", file=sys.stderr)
    code = int(os.environ.get("FAKE_RUNTIME_BUILD_EXIT", "0"))
    if code:
        sys.exit(code)
    with State() as st:
        st["images"][tag] = context


def run(args):
    takes_value = {"--name", "--label", "--cap-drop", "--security-opt", "--tmpfs", "--user",
                   "--network", "--workdir", "-v", "-e", "--pull"}
    name = label = None
    env = {}
    i = 0
    while args[i].startswith("-"):
        flag = args[i]
        if flag in takes_value:
            value = args[i + 1]
            i += 2
            if flag == "--name":
                name = value
            elif flag == "--label":
                label = value.split("=", 1)[1]
            elif flag == "-e":
                k, _, v = value.partition("=")
                env[k] = v
        else:
            i += 1  # -i, --rm, --read-only
    image, cmd = args[i], args[i + 1:]
    with State() as st:
        if image not in st["images"]:
            fail(f"Unable to find image '{image}' locally")
        context = st["images"][image]
        st["running"][name] = label

    def inside(word):  # the plugin lives at /plugin in the image: the build context here
        return context + word[len("/plugin"):] if word == "/plugin" or word.startswith("/plugin/") else word

    cmd = [inside(w) for w in cmd]
    os.chdir(context)
    # Like a real container: the command is found on the image's PATH (here: the host's, to find python3),
    # and the plugin itself only sees the image's default PATH unless -e gave one.
    program = shutil.which(cmd[0]) or cmd[0]
    env.setdefault("PATH", IMAGE_PATH)
    os.execve(program, cmd, env)


def ps(args):
    time.sleep(float(os.environ.get("FAKE_RUNTIME_PS_SLEEP", "0")))
    with State() as st:
        for name, label in st["running"].items():
            print(f"{name} {label}")


def rm(args):
    name = args[-1]
    with State() as st:
        if name not in st["running"]:
            fail(f"Error response from daemon: No such container: {name}")
        del st["running"][name]


COMMANDS = {"build": build, "run": run, "ps": ps, "rm": rm}
if argv[:2] == ["image", "inspect"]:
    image_inspect(argv[2:])
elif argv[:2] == ["image", "rm"]:
    image_rm(argv[2:])
elif argv and argv[0] in COMMANDS:
    COMMANDS[argv[0]](argv[1:])
else:
    fail(f"fake runtime: unsupported command {argv}", 125)
