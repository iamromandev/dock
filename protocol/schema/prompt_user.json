{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dock.dev/protocol/v2/prompt_user.json",
  "title": "prompt_user",
  "type": "object",
  "required": [
    "jsonrpc",
    "method",
    "params",
    "id"
  ],
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "method": {
      "const": "prompt_user"
    },
    "params": {
      "type": "object",
      "required": [
        "prompt"
      ],
      "properties": {
        "prompt": {
          "$ref": "common.json#/$defs/text"
        }
      }
    },
    "id": {
      "$ref": "common.json#/$defs/requestId"
    }
  }
}
