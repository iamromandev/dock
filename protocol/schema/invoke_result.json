{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dock.dev/protocol/v2/invoke_result.json",
  "title": "invoke_result",
  "type": "object",
  "required": [
    "jsonrpc",
    "id",
    "result"
  ],
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "id": {
      "$ref": "common.json#/$defs/requestId"
    },
    "result": {
      "type": "object",
      "required": [
        "exit_code"
      ],
      "properties": {
        "exit_code": {
          "type": "integer"
        },
        "outputs": {
          "type": "object"
        }
      }
    }
  }
}
