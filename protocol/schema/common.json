{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dock.dev/protocol/v2/common.json",
  "$defs": {
    "id": {
      "type": "string",
      "maxLength": 64
    },
    "text": {
      "type": "string"
    },
    "requestId": {
      "type": [
        "integer",
        "string"
      ]
    },
    "scalar": {
      "type": [
        "string",
        "number"
      ]
    },
    "error": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "integer"
        },
        "message": {
          "type": "string"
        },
        "data": {}
      }
    }
  }
}
