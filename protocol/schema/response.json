{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dock.dev/protocol/v2/response.json",
  "title": "response",
  "type": "object",
  "required": [
    "jsonrpc",
    "id"
  ],
  "oneOf": [
    {
      "required": [
        "result"
      ]
    },
    {
      "required": [
        "error"
      ]
    }
  ],
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "id": {
      "type": [
        "integer",
        "string",
        "null"
      ]
    },
    "error": {
      "$ref": "common.json#/$defs/error"
    }
  }
}
