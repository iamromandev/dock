{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dock.dev/protocol/v2/form_result.json",
  "title": "form_result",
  "type": "object",
  "required": [
    "jsonrpc",
    "id",
    "result"
  ],
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "id": {
      "$ref": "common.json#/$defs/requestId"
    },
    "result": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "values"
          ],
          "properties": {
            "values": {
              "type": "object"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "eof"
          ],
          "properties": {
            "eof": {
              "const": true
            }
          }
        }
      ]
    }
  }
}
